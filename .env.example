# Template for llm-service.env (a secret file, mode 600). install.sh creates
# llm-service.env from this file when it is missing, and asks for each API key
# whose line is empty. run.sh sources llm-service.env with bash, so keep to
# plain KEY=value lines and put single quotes around any value with spaces, $
# or parentheses (inside double quotes, bash still expands $).
# Restart the service after an edit.

# --- secrets ---
# Groq key for /api/transcribe.
GROQ_API_KEY=
# OpenRouter key for /api/explain.
OPENROUTER_API_KEY=
# Cerebras key for /api/memoir/*.
CEREBRAS_API_KEY=
# Azure Speech key for /api/transcribe-verbatim (MAI-Transcribe-2).
AZURE_SPEECH_KEY=

# --- transcription ---
GROQ_MODEL=whisper-large-v3-turbo
# Azure Speech endpoint for /api/transcribe-verbatim.
AZURE_SPEECH_ENDPOINT=https://eastus.api.cognitive.microsoft.com

# --- /api/explain model (OpenRouter) ---
# OpenRouter model id.
EXPLAIN_MODEL=google/gemini-3.8-flash
# Thinking budget in tokens (OpenRouter's reasoning.max_tokens). Thinking is
# never shown to the user.
EXPLAIN_REASONING_TOKENS=1024

# --- /api/memoir/* model (Cerebras) ---
# Cerebras model id.
MEMOIR_MODEL=qwen-3.8-27b
# low | medium | high, or none to turn reasoning off. Keep it on: without
# reasoning Qwen breaks the JSON contract and edits text it must leave alone.
MEMOIR_REASONING_EFFORT=medium

# --- server ---
# The clients and install.sh's health check expect exactly this address.
LISTEN_ADDR=127.0.0.1:8770

# --- paths: leave unset ---
# run.sh defaults it relative to this folder, so the folder can move without an
# edit. On Linux the service may only write data/ and logs/, so keep it inside
# data/.
# Default: <repo>/data/cache.db (the Merriam-Webster cache).
#CACHE_DB=
